{
  "name": "startec-site",
  "version": "5.0.0",
  "private": true,
  "description": "Star.Tec.Solutions (STS Digital, Antwerpen): statische site, gebouwd met python3 scripts/build.py, getest met Playwright.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "npx playwright install --with-deps chromium",
    "build": "python3 scripts/build.py --base https://8kawasaki8.github.io/startec-site/",
    "serve": "python3 -m http.server 8899 -d docs",
    "qa": "node scripts/qa/qa.mjs",
    "qa:quick": "node scripts/qa/qa.mjs --quick",
    "lint": "node scripts/qa/lint-css.mjs && node scripts/qa/lint-copy.mjs && node scripts/qa/meta-check.mjs && node scripts/qa/links.mjs",
    "links": "node scripts/qa/links.mjs",
    "lint:selftest": "node scripts/qa/lint-copy.mjs --selftest",
    "lines": "node scripts/qa/lint-lines.mjs",
    "meta": "node scripts/qa/meta-check.mjs",
    "deel": "node scripts/qa/lint-deel.mjs",
    "report": "node scripts/qa/qa.mjs --report-only",
    "audit": "npm run lines && npm run lint && npm run qa",
    "perf:css": "node scripts/qa/css-dead.mjs",
    "perf:img": "python3 scripts/img-shrink.py --check",
    "perf:selftest": "node scripts/qa/perf.mjs --selftest"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
